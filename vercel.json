{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!instagram'",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/m/:sha/:path*", "destination": "https://raw.githubusercontent.com/leonfpontes/insta_report/:sha/instagram/:path*" }
  ],
  "images": {
    "sizes": [640, 1080],
    "formats": ["image/webp"],
    "minimumCacheTTL": 86400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "raw.githubusercontent.com", "pathname": "/leonfpontes/insta_report/**" },
      { "protocol": "https", "hostname": "**.cdninstagram.com" },
      { "protocol": "https", "hostname": "**.fbcdn.net" }
    ]
  },
  "headers": [
    {
      "source": "/m/(.*)\\.mp4",
      "headers": [{ "key": "Content-Type", "value": "video/mp4" }]
    },
    {
      "source": "/m/(.*)\\.jpg",
      "headers": [{ "key": "Content-Type", "value": "image/jpeg" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
